      "hovered": {
        "background": "#f4f8fc"
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      },
      "disabled": {
        "opacity": 0.45
      }
    },
    ".btn-tray": {
      "background": "$panel",
      "border": {
        "width": 2,
        "color": "$line",
        "style": "solid"
      },
      "radius": 12,
      "padding": {
        "top": 10,
        "end": 16,
        "bottom": 10,
        "start": 16
